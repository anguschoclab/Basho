{
  "$schema": "https://unpkg.com/knip@next/schema.json",
  "entry": [
    "src/main.tsx",
    "electron/main.ts",
    "electron/preload.ts",
    "src/engine/simulation/run.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "electron/**/*.{ts,tsx}"],
  "ignore": ["**/*.test.ts", "**/*.test.tsx", "src/__tests__/**/*"],
  "ignoreDependencies": ["@types/node", "@types/react", "@types/react-dom"]
}
