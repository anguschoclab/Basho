# Bard Engine v2.2 - Narrative Pipeline Configuration
# Copy this file to .env and fill in your Gemini API Key

# Your Google Gemini API Key (from Google AI Studio)
# Consumed by: scripts/bard-orchestrator.ts, .github/workflows/autonomous-narrative.yml
GEMINI_API_KEY=your_gemini_api_key_here

# Alternate name read by scripts/list-models.ts
VITE_GEMINI_API_KEY=

# Optional: orchestrator model selection (defaults shown)
GEMINI_MODEL_PRIMARY=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
