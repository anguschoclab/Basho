{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "src/**/*.d.ts",
    "tests/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": []
}
